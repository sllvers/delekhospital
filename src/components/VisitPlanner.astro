---
import { careServices } from '../data/care';
import { locations } from '../data/locations';
const hospital = locations[0];
---
<section class="visit-planner" aria-labelledby="visit-title" data-visit-planner>
 <div class="planner-heading"><span class="eyebrow">Find care</span><h2 id="visit-title">Your clinic.<br />Your visit.</h2><p>Select a service for hours, location and contact information.</p><div class="service-choice" hidden><label for="visit-service">What service do you need?</label><select id="visit-service">{careServices.map(service=><option value={service.id}>{service.title}</option>)}</select></div><noscript><p>Service information is listed below.</p></noscript></div>
 <div class="visit-results">{careServices.map(service=><article data-visit-service={service.id} aria-labelledby={`visit-${service.id}`}><h3 id={`visit-${service.id}`}>{service.title}</h3><p class="service-description">{service.description}</p><dl><div><dt>When to visit</dt><dd>{service.clinic?.days ?? 'Contact the hospital to arrange your visit'}<strong>{service.clinic?.hours ?? 'Call to confirm hours'}</strong><p>{service.clinic?.note ?? 'Please confirm availability and appointment requirements before travelling.'}</p></dd></div><div><dt>Where to go</dt><dd>{hospital.name}<p>{hospital.address}</p></dd></div></dl><div class="actions">{service.clinic && <a class="button" href={`/find-care/schedules?clinic=${service.clinic.id}`}>See {service.title.toLowerCase()} schedule</a>}<a class={service.clinic ? 'text-link' : 'button'} href="tel:+911892222053">Call hospital</a><a class="text-link" href="/find-care/locations#main-hospital">Directions</a></div></article>)}<p class="note availability">Listed hours may change. Please call before travelling. Saturday hours are listed separately on the schedules page.</p><p class="selection-status sr-only" role="status" aria-live="polite"></p></div>
</section>
<style>
.visit-planner{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(28px,5vw,64px);border-top:2px solid var(--color-accent);padding:40px 0 48px}.planner-heading h2{font-family:Georgia,serif;font-size:clamp(30px,3.5vw,44px);line-height:1.15;margin-bottom:20px}.planner-heading>p{max-width:34ch;color:var(--color-text-muted);line-height:1.7}.service-choice{margin-top:28px}.service-choice label{display:block;font-size:14px;font-weight:600;margin-bottom:10px}.service-choice select{width:100%;max-width:420px;padding:15px 36px 15px 14px;border:1px solid #9aaabe;border-radius:6px;background:var(--color-surface);font:inherit;color:var(--color-text)}select:focus-visible{outline:2px solid var(--color-accent);outline-offset:4px}.visit-results{min-width:0;border-left:1px solid var(--color-border);padding-left:clamp(24px,4vw,48px)}article[hidden],.service-choice[hidden]{display:none}article+article{margin-top:0}article h3{font-size:27px;line-height:1.3;font-weight:500;margin-bottom:8px}.service-description{color:var(--color-text-muted);line-height:1.7}dl{margin-top:24px}dl>div{display:grid;grid-template-columns:100px 1fr;gap:20px;border-top:1px solid var(--color-border);padding:20px 0}dt{font-size:11px;text-transform:uppercase;letter-spacing:.08em;padding-top:4px}dd{line-height:1.7;font-size:15px}dd strong{display:block;color:var(--color-accent);font-weight:600}dd p{font-size:14px;color:var(--color-text-muted);margin-top:6px}.actions{align-items:center;gap:20px;margin-top:12px}.actions .text-link{font-size:14px}.availability{margin-top:28px}
@media(max-width:767px){.visit-planner{grid-template-columns:1fr;padding-top:28px}.visit-results{border-left:0;border-top:1px solid var(--color-border);padding:28px 0 0}dl>div{grid-template-columns:1fr;gap:8px}.service-choice select{max-width:none}}
</style>
<script>
function initVisitPlanner(){
 const root=document.querySelector<HTMLElement>('[data-visit-planner]');if(!root)return;
 const select=root.querySelector<HTMLSelectElement>('select')!;
 root.querySelector<HTMLElement>('.service-choice')!.hidden=false;
 const render=(announce=false)=>{root.querySelectorAll<HTMLElement>('[data-visit-service]').forEach(panel=>{panel.hidden=panel.dataset.visitService!==select.value;if(!panel.hidden&&announce&&!matchMedia('(prefers-reduced-motion: reduce)').matches){panel.getAnimations().forEach(animation=>animation.cancel());panel.animate([{opacity:.35,transform:'translateY(4px)'},{opacity:1,transform:'translateY(0)'}],{duration:180,easing:'ease-out'});}});if(announce)root.querySelector<HTMLElement>('.selection-status')!.textContent=`Visit information updated for ${select.selectedOptions[0].textContent}.`;};
 select.addEventListener('change',()=>render(true));render();
}
document.addEventListener('astro:page-load',initVisitPlanner);
</script>
