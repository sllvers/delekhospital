---

<footer class="border-t border-[var(--color-surface-alt)] bg-[var(--color-surface)] text-[var(--color-text-muted)] py-16">
  <div class="max-w-[1400px] mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-10">
    <div>
      <h3 class="text-[var(--color-primary)] font-semibold text-base mb-4">Hospital Name</h3>
      <p class="text-sm">Dedicated to compassionate care, medical excellence, and community well-being.</p>
    </div>
    <div>
      <h4 class="text-[var(--color-primary)] font-medium text-sm mb-3">Navigation</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/about" class="hover:text-[var(--color-primary)] transition-colors">About Us</a></li>
        <li><a href="/team" class="hover:text-[var(--color-primary)] transition-colors">Our Team</a></li>
        <li><a href="/milestones" class="hover:text-[var(--color-primary)] transition-colors">Milestones</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-[var(--color-primary)] font-medium text-sm mb-3">Support</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/contact" class="hover:text-[var(--color-primary)] transition-colors">Contact</a></li>
        <li><a href="/contact" class="hover:text-[var(--color-primary)] transition-colors">Emergency Services</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-[var(--color-primary)] font-medium text-sm mb-3">Legal</h4>
      <p class="text-xs">© {new Date().getFullYear()} Hospital Name. Non-profit healthcare institution.</p>
    </div>
  </div>
</footer>
