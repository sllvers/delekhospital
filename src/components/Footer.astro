---
---

<footer class="ornament-footer border-t border-[var(--color-surface-alt)] bg-[var(--color-surface)] text-[var(--color-text-muted)] py-16">
  {['top-left', 'top-right', 'bottom-right', 'bottom-left'].map(corner => (
    <svg class={`footer-corner ${corner}`} viewBox="0 0 210 210" fill="none" aria-hidden="true" focusable="false">
      <g stroke="currentColor" stroke-width="8" stroke-linecap="square" stroke-linejoin="miter">
        <path d="M16 192V152H40V130H16V106H62V22H86V46H16V22H44V88H16V66H104V22H128V50H150V22H196" />
      </g>
    </svg>
  ))}

  <div class="max-w-[1400px] mx-auto px-6 grid grid-cols-1 md:grid-cols-4 gap-10">
    <div>
      <h3 class="text-[var(--color-primary)] font-semibold text-base mb-4">Delek Hospital</h3>
      <p class="text-sm mb-4">Dedicated to compassionate care, medical excellence, and community well-being.</p>
      <div class="flex items-center space-x-3">
        <a 
          href="https://www.facebook.com/Delek-Hospital-Dharamsala-220833531445744/" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Facebook"
          class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-surface-alt)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
        <a 
          href="https://instagram.com/delekmenkhang" 
          target="_blank" 
          rel="noopener noreferrer" 
          aria-label="Instagram"
          class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-[var(--color-surface-alt)] text-[var(--color-primary)] hover:bg-[var(--color-primary)] hover:text-white transition-colors"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
        </a>
      </div>
    </div>
    <div>
      <h4 class="text-[var(--color-primary)] font-medium text-sm mb-3">Navigation</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/about" class="hover:text-[var(--color-primary)] transition-colors">About Us</a></li>
        <li><a href="/team" class="hover:text-[var(--color-primary)] transition-colors">Our Team</a></li>
        <li><a href="/milestones" class="hover:text-[var(--color-primary)] transition-colors">Milestones</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-[var(--color-primary)] font-medium text-sm mb-3">Care & Support</h4>
      <ul class="space-y-2 text-sm">
        <li><a href="/contact" class="hover:text-[var(--color-primary)] transition-colors">Contact</a></li>
        <li><a href="/find-care" class="hover:text-[var(--color-primary)] transition-colors">Find Care</a></li>
        <li><a href="/our-impact" class="hover:text-[var(--color-primary)] transition-colors">Our Impact</a></li>
        <li><a href="/partner-with-us" class="hover:text-[var(--color-primary)] transition-colors">Partner With Us</a></li>
        <li><a href="/support" class="hover:text-[var(--color-primary)] transition-colors">Donate</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-[var(--color-primary)] font-medium text-sm mb-3">Legal</h4>
      <p class="text-xs">© {new Date().getFullYear()} Delek Hospital. Non-profit healthcare institution.</p>
    </div>
  </div>
</footer>

<style>
.ornament-footer{position:relative;padding:100px 90px;isolation:isolate}
.footer-corner{position:absolute;width:100px;height:100px;color:#ed2929;pointer-events:none;z-index:-1}
.top-left{top:12px;left:12px}.top-right{top:12px;right:12px;transform:rotate(90deg)}
.bottom-right{bottom:12px;right:12px;transform:rotate(180deg)}.bottom-left{bottom:12px;left:12px;transform:rotate(270deg)}
@media(max-width:767px){.ornament-footer{padding:76px 24px}.footer-corner{width:62px;height:62px}.top-left,.top-right{top:8px}.bottom-left,.bottom-right{bottom:8px}.top-left,.bottom-left{left:8px}.top-right,.bottom-right{right:8px}}
</style>
