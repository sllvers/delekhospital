---
import BaseLayout from '../../layouts/BaseLayout.astro';
import outreach from '../../assets/tb-outreach.jpg';
import clinic from '../../assets/tb-clinic.jpg';
import cataract from '../../assets/cataract-team.jpg';
import elders from '../../assets/elder-care.jpg';
import { programs } from '../../data/programs';
import '../../styles/editorial.css';
const featured=programs[0];
const eye=programs.find(p=>p.slug==='cataract-camp')!;
---
<BaseLayout title="Our Impact — Delek Hospital" description="Explore Delek Hospital’s public health programs, community outreach and clinical education.">
<div class="editorial-page">
<header class="ed-intro ed-wrap"><p class="ed-label">Our impact</p><div class="ed-intro-grid"><h1>Care beyond<br />our doors.</h1><p>Through prevention, public health, education and partnerships, Delek works alongside the communities it serves.</p></div></header>
<figure class="outreach-banner"><img src={outreach.src} width={outreach.width} height={outreach.height} alt="Healthcare workers conducting community screening in an outdoor courtyard" fetchpriority="high" /><figcaption class="ed-wrap">Bringing screening and care into the community.</figcaption></figure>
<section class="tb-feature ed-wrap"><div class="ed-copy"><p class="ed-label">A continuing commitment</p><h2>Care today.<br />Prevention for tomorrow.</h2><p>{featured.summary}</p><p>Clinical care, community-based treatment and prevention connect people with support throughout their care.</p><a class="ed-link" href={`/our-impact/${featured.slug}`}>Explore the Tibetan TB Program <span aria-hidden="true">↗</span></a></div><figure><img src={clinic.src} width={clinic.width} height={clinic.height} alt="A healthcare worker reviewing a chest X-ray at Delek’s TB clinic" loading="lazy" /><figcaption>At the Delek TB clinic.</figcaption></figure></section>
<section class="program-section"><div class="ed-wrap program-layout"><div><p class="ed-label">Our areas of work</p><h2>Different needs.<br />A shared purpose.</h2><figure class="cataract-photo"><img src={cataract.src} width={cataract.width} height={cataract.height} alt="A masked surgical team at work during a cataract surgery camp" loading="lazy" /><figcaption>Care through specialist partnerships.</figcaption></figure><a class="ed-link" href={`/our-impact/${eye.slug}`}>Inside the cataract camp <span aria-hidden="true">↗</span></a></div><div class="program-list">{programs.slice(1).map((program,index)=><a href={`/our-impact/${program.slug}`}><span class="program-number" aria-hidden="true">0{index+1}</span><div><h3>{program.title}</h3><p>{program.summary}</p></div><span aria-hidden="true">↗</span></a>)}</div></div></section>
<section class="elders ed-wrap"><figure><img src={elders.src} width={elders.width} height={elders.height} alt="A healthcare worker checking an older woman’s finger with a pulse oximeter" loading="lazy" /><figcaption>Connecting older residents with healthcare.</figcaption></figure><div class="ed-copy"><p class="ed-label">Community outreach</p><h2>Caring for<br />our elders.</h2><p>Delek’s outreach includes medical consultations at Jampaling Old Age Home, extending care beyond the hospital and helping older residents remain connected to healthcare.</p></div></section>
<aside class="ed-closing"><div class="ed-wrap"><div><p class="ed-label">Support community care</p><h2>Help this work<br />continue.</h2></div><div><p>Your support helps sustain accessible treatment, prevention and outreach.</p><a class="ed-link" href="/support">Support Delek <span aria-hidden="true">↗</span></a><a class="ed-link" href="/partner-with-us">Partner with us <span aria-hidden="true">↗</span></a></div></div></aside>
</div></BaseLayout>
<style>
.outreach-banner>img{height:clamp(320px,43vw,600px);object-position:center 45%}.tb-feature{display:grid;grid-template-columns:1fr 1.3fr;align-items:center;gap:88px;padding-block:80px}.tb-feature img{aspect-ratio:5/4;object-position:center 25%}.program-section{padding-block:64px;background:var(--color-surface-alt)}.program-layout{display:grid;grid-template-columns:1fr 1.5fr;gap:80px}.program-layout h2{font-size:clamp(34px,3.8vw,50px)}.cataract-photo{margin-top:40px!important}.cataract-photo img{aspect-ratio:4/3}.program-list>a{display:grid;grid-template-columns:24px 1fr 20px;gap:20px;padding:24px 0;border-top:1px solid var(--color-border)}.program-number{font-size:11px;padding-top:6px}.program-list h3{font-size:22px;line-height:1.3;font-weight:500;margin-bottom:10px}.program-list p{font-size:14px;line-height:1.8;color:var(--color-text-muted)}.program-list>a>span:last-child{transition:transform .2s ease}.program-list>a:hover>span:last-child{transform:translate(3px,-3px)}.elders{display:grid;grid-template-columns:1.3fr 1fr;gap:88px;align-items:center;padding-block:88px}.elders img{aspect-ratio:4/3}
@media(max-width:767px){.tb-feature,.program-layout,.elders{grid-template-columns:1fr;gap:28px}.tb-feature,.elders{padding-block:48px}.program-section{padding-block:40px}.program-list{margin-top:16px}.program-list h3{font-size:20px}.cataract-photo{margin-top:28px!important}.outreach-banner>img{height:320px}.program-list>a{gap:12px}}
@media(prefers-reduced-motion:reduce){.program-list>a>span:last-child{transition:none;transform:none!important}}
</style>
