---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TBProgramFeature from '../../components/TBProgramFeature.astro';
import cataract from '../../assets/cataract-team.jpg';
import screening from '../../assets/community-screening.jpg';
import cardiac from '../../assets/cardiac-camp.jpg';
import teaching from '../../assets/clinical-teaching.jpg';
import PageIntro from '../../components/PageIntro.astro';
import { programs } from '../../data/programs';
export function getStaticPaths() { return programs.map(program => ({ params: {slug:program.slug}, props: {program} })); }
const { program } = Astro.props;
const photo = program.slug === 'cataract-camp' ? {image:cataract,alt:'Clinical teams working during Delek’s cataract surgery camp',caption:'Specialist teams working together during the cataract camp.'} : program.slug === 'hepatitis-b' ? {image:screening,alt:'A healthcare worker speaking with community members during screening',caption:'Community screening and consultation.'} : program.slug === 'cardiac-screening' ? {image:cardiac,alt:'A clinician conducting an ultrasound examination during a cardiac camp',caption:'An examination during a cardiac camp.'} : program.slug === 'clinical-education' ? {image:teaching,alt:'Clinicians participating in a practical examination and teaching session',caption:'Clinical expertise shared through hands-on teaching.'} : null;
---
<BaseLayout title={`${program.title} — Delek Hospital`} description={program.summary}>{program.slug === 'tibetan-tb-program' ? <TBProgramFeature /> : <div class="content-wrap"><PageIntro eyebrow="Our Impact" title={program.title} description={program.summary} />{photo && <figure class="program-documentary"><img src={photo.image.src} width={photo.image.width} height={photo.image.height} alt={photo.alt} loading="lazy" /><figcaption>{photo.caption}</figcaption></figure>}<section class="section"><h2>About the program</h2><p>{program.about}</p></section><section class="section"><h2>Our work</h2><p>{program.work}</p></section><aside class="callout"><h2>Connect with Delek</h2><p>Contact the hospital for program information or ways to support this work.</p><div class="actions"><a class="button" href="/contact">Contact Delek</a><a class="button button-secondary" href="/our-impact">All programs</a></div></aside></div>}</BaseLayout>

<style>.program-documentary{margin:0 0 32px}.program-documentary img{width:100%;max-height:520px;object-fit:cover}.program-documentary figcaption{font-size:12px;line-height:1.6;margin-top:12px;color:var(--color-text-muted)}@media(max-width:767px){.program-documentary img{max-height:none;height:auto}}</style>
