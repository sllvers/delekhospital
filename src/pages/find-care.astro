---
import BaseLayout from '../layouts/BaseLayout.astro';
import VisitPlanner from '../components/VisitPlanner.astro';
import exterior from '../assets/hospital-exterior.jpg';
import consultation from '../assets/clinical-consultation.jpg';
import tbClinic from '../assets/tb-clinic.jpg';
---
<BaseLayout title="Find Care — Delek Hospital" description="Plan your visit to Delek Hospital in Dharamshala. Explore clinic hours, medical services, TB care and directions.">
<div class="care-editorial">
<header class="care-hero">
 <img class="hero-image" src={exterior.src} width={exterior.width} height={exterior.height} alt="Delek Hospital overlooking Dharamshala at sunset" fetchpriority="high" />
 <div class="hero-shade"></div>
 <div class="hero-content"><p class="kicker">Delek Hospital / Dharamshala</p><h1>Care, close<br />to community.</h1><div class="hero-bottom"><p>Find the care you need.<br />Plan your visit with us.</p><a href="#plan-visit" class="hero-link">Find your clinic <span aria-hidden="true">↓</span></a></div></div>
 <span class="hero-caption">Serving our community since 1971</span>
</header>
<nav class="care-shortcuts" aria-label="Patient quick links"><a href="/find-care/schedules">Clinic schedules <span aria-hidden="true">↗</span></a><a href="/find-care/locations">Directions & locations <span aria-hidden="true">↗</span></a><a href="tel:+911892222053">Call +91 1892 222053 <span aria-hidden="true">↗</span></a></nav>
<section class="clinic-section editorial-wrap" id="plan-visit" aria-label="Plan your visit"><VisitPlanner /></section>
<section class="care-story editorial-wrap" aria-labelledby="care-heading">
 <div class="story-heading"><p class="kicker">The people behind your care</p><h2 id="care-heading">Here for you.<br />Through every visit.</h2></div>
 <div class="story-grid"><figure class="consultation-frame photo-reveal"><img src={consultation.src} width={consultation.width} height={consultation.height} alt="A clinician examines a child with a stethoscope while another healthcare worker assists" loading="lazy" /><figcaption><span>01 / At the hospital</span><span>Delek Hospital, Dharamshala</span></figcaption></figure><div class="story-aside"><p>From outpatient consultations to ongoing treatment, our team provides care for the communities of Dharamshala.</p><a class="editorial-link" href="/find-care/services">Explore medical services <span aria-hidden="true">↗</span></a><a class="editorial-link" href="/team">Meet our team <span aria-hidden="true">↗</span></a></div></div>
 <div class="tb-story"><div class="tb-copy"><p class="kicker">Continuity of care</p><h2>Support beyond<br />a diagnosis.</h2><p>Find practical information about TB diagnosis, treatment, follow-up and patient support at Delek.</p><a class="editorial-link" href="/find-care/tb-care">TB care at Delek <span aria-hidden="true">↗</span></a></div><figure class="tb-frame photo-reveal"><img src={tbClinic.src} width={tbClinic.width} height={tbClinic.height} alt="A healthcare worker reviewing a chest X-ray outside the Delek TB clinic" loading="lazy" /><figcaption>02 / At the TB clinic</figcaption></figure></div>
</section>
<section class="arrival" aria-labelledby="arrival-title"><div class="editorial-wrap arrival-inner"><div><p class="kicker">Before you travel</p><h2 id="arrival-title">Let’s plan<br />your visit.</h2></div><div class="arrival-details"><p>Clinic availability can change. Please call to confirm appointments and the service you need.</p><a class="editorial-link" href="tel:+911892222053">+91 1892 222053 <span aria-hidden="true">↗</span></a><a class="editorial-link" href="/find-care/locations">Find Delek Hospital <span aria-hidden="true">↗</span></a></div></div></section>
</div>
</BaseLayout>
<style>
.care-editorial{--ink:#263c31;--paper:#f3f0e8;background:var(--paper);color:var(--ink)}.editorial-wrap{width:min(100% - 96px,1240px);margin-inline:auto}.kicker{font-size:11px;text-transform:uppercase;letter-spacing:.16em;font-weight:500;line-height:1.6;margin-bottom:24px}.care-hero{position:relative;min-height:580px;height:min(76vh,800px);isolation:isolate;background:#27382f;overflow:hidden}.hero-image,.hero-shade{position:absolute;inset:0;width:100%;height:100%;z-index:-1}.hero-image{object-fit:cover;object-position:center 48%}.hero-shade{background:linear-gradient(90deg,rgba(11,25,20,.82),rgba(11,25,20,.25) 62%,rgba(11,25,20,.08)),linear-gradient(0deg,rgba(11,25,20,.5),transparent 40%)}.hero-content{height:100%;min-height:580px;display:flex;flex-direction:column;justify-content:center;padding:60px max(48px,calc((100vw - 1240px)/2));color:#fffdf5}.hero-content h1{font-family:Georgia,serif;font-weight:400;font-size:clamp(64px,7.6vw,112px);letter-spacing:-.045em;line-height:1.02;margin:0 0 40px}.hero-bottom{display:flex;align-items:end;gap:64px}.hero-bottom p{font-size:17px;line-height:1.65;color:#f1efe6}.hero-link{display:flex;gap:36px;padding:12px 0;border-bottom:1px solid #d9dfd5;font-size:14px}.hero-caption{position:absolute;right:32px;bottom:28px;color:#fff;font-size:11px;letter-spacing:.06em}.care-shortcuts{display:grid;grid-template-columns:repeat(3,1fr);background:var(--ink);color:#fffdf5;padding-inline:max(48px,calc((100vw - 1240px)/2))}.care-shortcuts a{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:24px;border-right:1px solid #5a6a60;font-size:14px}.care-shortcuts a:first-child{padding-left:0}.care-shortcuts a:last-child{border:0;padding-right:0}.care-shortcuts span,.editorial-link span,.hero-link span{transition:transform .2s ease}.care-shortcuts a:hover span,.editorial-link:hover span{transform:translate(3px,-3px)}.hero-link:hover span{transform:translateY(3px)}.clinic-section{padding-block:64px;border-bottom:1px solid #c8c9bd;scroll-margin-top:100px}.clinic-section :global(.visit-planner){padding:0;border:0;grid-template-columns:.75fr 1.25fr;gap:64px}.clinic-section :global(.planner-heading h2){font-family:Georgia,serif;font-size:42px;letter-spacing:-.035em;line-height:1.1}.clinic-section :global(.planner-heading>p){font-size:15px}.clinic-section :global(.service-choice select){border-radius:0;background:transparent;border:0;border-bottom:1px solid #687d6d;padding-left:0}.clinic-section :global(.visit-results){border:0;padding:0}.clinic-section :global(article h3){font-size:24px}.clinic-section :global(dl){display:grid;grid-template-columns:1fr 1fr;gap:32px;margin-top:20px}.clinic-section :global(dl>div){display:block;padding:16px 0}.clinic-section :global(dt){margin-bottom:12px}.clinic-section :global(.availability){font-size:12px;margin-top:20px}.clinic-section :global(.button){border-radius:0;padding:12px 18px}.care-story{padding-block:88px}.story-heading{display:grid;grid-template-columns:1fr 2fr;gap:48px;align-items:start;margin-bottom:48px}.care-story h2,.arrival h2{font-family:Georgia,serif;font-size:clamp(38px,4.7vw,66px);font-weight:400;line-height:1.08;letter-spacing:-.035em}.story-heading .kicker{padding-top:10px}.story-grid{display:grid;grid-template-columns:1.65fr 1fr;gap:64px;align-items:end}figure{margin:0}figure img{display:block;width:100%;height:auto;object-fit:cover}.consultation-frame img{aspect-ratio:4/3}figcaption{display:flex;justify-content:space-between;gap:16px;font-size:11px;color:#586357;line-height:1.6;padding-top:12px}.story-aside{padding-bottom:30px}.story-aside>p{font-size:20px;line-height:1.65;margin-bottom:32px}.editorial-link{display:flex;justify-content:space-between;align-items:center;gap:24px;border-bottom:1px solid #a7b2a3;padding:18px 0;font-size:14px}.tb-story{display:grid;grid-template-columns:1fr 1.35fr;gap:100px;margin:88px 0 0 10%;align-items:center}.tb-copy>p:not(.kicker){font-size:16px;line-height:1.8;color:#586357;margin-block:24px}.tb-frame img{aspect-ratio:5/4;object-position:center 25%}.arrival{background:#e0e3d6;border-top:1px solid #c8cebe;padding-block:64px}.arrival-inner{display:grid;grid-template-columns:1fr 1fr;gap:100px;align-items:center}.arrival-details>p{font-size:17px;line-height:1.8;margin-bottom:20px;max-width:42ch}.care-hero a:focus-visible,.care-shortcuts a:focus-visible{outline:2px solid white;outline-offset:5px}.photo-enter{animation:photo-enter .45s ease-out both}@keyframes photo-enter{from{opacity:.6;transform:translateY(12px)}to{opacity:1;transform:none}}
@media(max-width:900px){.hero-bottom{gap:32px}.clinic-section :global(.visit-planner){gap:32px}.story-grid{gap:32px}.tb-story{gap:40px;margin-left:0}.care-shortcuts a{font-size:12px;padding-inline:16px}.arrival-inner{gap:40px}}
@media(max-width:767px){.editorial-wrap{width:calc(100% - 40px)}.care-hero{height:auto;min-height:540px}.hero-content{min-height:540px;padding:48px 24px 72px}.hero-content h1{font-size:58px;margin-bottom:28px}.hero-image{object-position:60% center}.hero-shade{background:linear-gradient(90deg,rgba(11,25,20,.8),rgba(11,25,20,.35))}.hero-bottom{align-items:start;flex-direction:column;gap:20px}.hero-bottom p{font-size:16px}.hero-caption{bottom:20px;left:24px;right:auto;font-size:10px}.care-shortcuts{grid-template-columns:1fr;padding:8px 20px}.care-shortcuts a,.care-shortcuts a:first-child,.care-shortcuts a:last-child{padding:16px 0;border-right:0;font-size:14px;border-bottom:1px solid #5a6a60}.care-shortcuts a:last-child{border-bottom:0}.clinic-section{padding-block:40px}.clinic-section :global(.visit-planner){grid-template-columns:1fr;gap:32px}.clinic-section :global(dl){grid-template-columns:1fr;gap:0}.clinic-section :global(.planner-heading h2){font-size:36px}.care-story{padding-block:48px}.story-heading,.story-grid,.tb-story,.arrival-inner{grid-template-columns:1fr;gap:24px}.story-heading{margin-bottom:28px}.story-heading .kicker{padding:0;margin:0}.story-aside{padding-bottom:0}.story-aside>p{font-size:18px;margin-bottom:16px}.tb-story{margin-top:56px}.tb-frame{grid-row:1}.tb-copy h2 br{display:none}figcaption{font-size:10px;flex-wrap:wrap}.arrival{padding-block:40px}.arrival h2 br{display:none}}
@media(prefers-reduced-motion:reduce){.photo-enter{animation:none}.care-shortcuts span,.editorial-link span,.hero-link span{transition:none;transform:none!important}}
</style>
<script>
document.addEventListener('astro:page-load',()=>{
 if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;
 const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('photo-enter');observer.unobserve(entry.target);}}),{threshold:.1});
 document.querySelectorAll('.photo-reveal').forEach(photo=>observer.observe(photo));
 document.addEventListener('astro:before-swap',()=>observer.disconnect(),{once:true});
});
</script>
