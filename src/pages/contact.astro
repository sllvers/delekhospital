---
import BaseLayout from '../layouts/BaseLayout.astro';
import { locations } from '../data/locations';
const hospital = locations[0];
---
<BaseLayout title="Contact Us — Delek Hospital">
<div class="contact-page">
  <header class="contact-hero">
    <div class="wrap hero-grid">
      <div><p class="eyebrow">Delek Hospital · Dharamshala</p><h1>Get in touch.</h1><p class="intro">Planning a visit or have a question?<br />We’re here to help you find your way.</p></div>
      <svg class="hospital-art" viewBox="0 0 480 300" fill="none" aria-hidden="true">
        <circle cx="354" cy="67" r="35" fill="#e4c58e"/>
        <path d="M8 209 118 64 211 176 292 83 466 218" fill="#527364"/>
        <path d="m77 118 41-54 44 53-30-9-16 13-15-14Z" fill="#dbe4d5"/>
        <path d="m264 119 28-36 46 48-27-8-17 6-13-15Z" fill="#b8cbbb"/>
        <path d="M0 242c89-62 135-41 205-15 94-54 175-43 275 15v58H0Z" fill="#385747"/>
        <rect x="91" y="157" width="277" height="107" rx="3" fill="#e5e5d6"/>
        <path d="M79 157h301l-15-17H94Z" fill="#b8cbbb"/>
        <rect x="186" y="112" width="90" height="152" rx="3" fill="#fbf7ec"/>
        <path d="M176 112h110l-9-12h-92Z" fill="#b8cbbb"/>
        <path d="M224 128h14v13h13v14h-13v13h-14v-13h-13v-14h13Z" fill="#527364"/>
        <g fill="#527364"><rect x="111" y="176" width="23" height="28"/><rect x="149" y="176" width="23" height="28"/><rect x="291" y="176" width="23" height="28"/><rect x="329" y="176" width="23" height="28"/><rect x="111" y="219" width="23" height="28"/><rect x="149" y="219" width="23" height="28"/><rect x="291" y="219" width="23" height="28"/><rect x="329" y="219" width="23" height="28"/></g>
        <path d="M209 264v-52a22 22 0 0 1 44 0v52" fill="#385747"/>
        <path d="M231 211v53M201 270h60M192 277h78" stroke="#b8cbbb" stroke-width="3"/>
        <path d="m209 280-25 20h97l-27-20" fill="#b8cbbb"/>
        <path d="M56 266v-64M411 267v-72" stroke="#b8cbbb" stroke-width="4"/>
        <path d="M56 165c-29 25-33 56 0 66 33-10 29-41 0-66ZM411 158c-32 30-34 62 0 73 34-11 32-43 0-73Z" fill="#759782"/>
      </svg>
    </div>
  </header>
  <section class="contact-cards wrap" aria-label="Ways to contact the hospital">
    <article class="contact-card">
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m9 3 5 7-4 4c2 4 4 6 8 8l4-4 7 5-3 5C15 30 2 17 4 6Z" stroke-linejoin="round"/></svg>
      <h2>Call the hospital</h2><p>For clinic availability and help planning your visit, speak with our hospital team.</p>
      <a class="phone" href="tel:+911892222053">+91 1892 222053</a>
      <details><summary>Other hospital numbers</summary><div><a href="tel:+911892223381">+91 1892 223381</a><a href="tel:+911892222406">+91 1892 222406</a></div></details>
    </article>
    <article class="contact-card">
      <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="6" width="26" height="20" rx="2"/><path d="m4 8 12 10L28 8" stroke-linejoin="round"/></svg>
      <h2>Email us</h2><p>Have a general enquiry? Send a message to the hospital team using your email app.</p>
      <a class="email-address" href="mailto:hospitaldelek@yahoo.com">hospitaldelek@yahoo.com</a>
      <a class="email-button" href="mailto:hospitaldelek@yahoo.com">Write to us <span aria-hidden="true">↗</span></a>
    </article>
  </section>
  <section class="visit wrap" aria-labelledby="visit-heading">
    <div class="visit-heading"><p class="eyebrow">Visit us</p><h2 id="visit-heading">Find us in Dharamshala.</h2></div>
    <div class="visit-grid">
      <div class="visit-copy"><h3>Delek Hospital</h3><address>Gangchen Kyishong, Dharamshala<br />District Kangra, Himachal Pradesh<br />India – 176215</address><a class="directions" href={hospital.directions} target="_blank" rel="noopener noreferrer">Get directions <span aria-hidden="true">↗</span></a><div class="before-visit"><h3>Before you travel</h3><p>Clinic and specialist hours vary. Check the schedule and call to confirm availability.</p><a href="/find-care/schedules">View clinic schedules →</a></div></div>
      <iframe title="Map showing Delek Hospital in Dharamshala" src={hospital.map} width="100%" height="440" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    </div>
  </section>
</div>
</BaseLayout>
<style>
.contact-page{background:#fafaf7;color:var(--color-text)}.wrap{width:min(1160px,calc(100% - 80px));margin-inline:auto}.contact-hero{background:var(--color-primary);color:#fbf7ec}.hero-grid{display:grid;grid-template-columns:1.25fr 1fr;align-items:center;gap:56px;padding-block:52px 100px}.eyebrow{font-size:11px;letter-spacing:.16em;text-transform:uppercase;margin-bottom:20px}.contact-hero h1{font:400 clamp(48px,5.6vw,76px)/1.1 Georgia,serif;letter-spacing:-.04em}.intro{font-size:18px;line-height:1.8;margin-top:22px;color:#e0e8f4}.hospital-art{display:block;width:100%;max-width:440px;justify-self:end}.contact-cards{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:28px;margin-top:-56px;align-items:start}.contact-card{background:#fff;border:1px solid var(--color-border);border-radius:12px;padding:34px 38px;text-align:center;min-height:345px;box-shadow:0 7px 22px #002d7205}.contact-card>svg{width:38px;height:38px;margin:0 auto 22px}.contact-card h2{font-size:21px;font-weight:600;margin-bottom:16px}.contact-card p{font-size:15px;line-height:1.8;color:var(--color-text-muted);max-width:385px;margin:0 auto 20px}.phone{font-size:21px;font-weight:500;text-decoration:underline;text-underline-offset:5px}.email-address{display:block;font-size:15px;overflow-wrap:anywhere}.email-button{display:inline-flex;align-items:center;gap:30px;background:var(--color-accent);color:white;padding:13px 26px;margin-top:20px;border-radius:4px;transition:background .2s}.email-button:hover{background:var(--color-primary)}details{margin-top:22px;font-size:13px}summary{cursor:pointer;text-decoration:underline;text-underline-offset:4px}details>div{display:grid;gap:10px;padding-top:16px}.visit{padding-block:72px 80px}.visit-heading{text-align:center;margin-bottom:42px}.visit-heading h2{font:400 clamp(32px,4vw,48px)/1.15 Georgia,serif;letter-spacing:-.03em}.visit-grid{display:grid;grid-template-columns:.8fr 1.35fr;border:1px solid var(--color-border);background:var(--color-surface-alt)}.visit-copy{padding:38px}.visit-copy h3{font-size:19px;font-weight:500;margin-bottom:16px}address{font-style:normal;font-size:14px;line-height:1.9;color:var(--color-text-muted)}.directions{display:flex;justify-content:space-between;gap:16px;padding:18px 0;border-bottom:1px solid var(--color-border);font-size:14px}.before-visit{margin-top:28px}.before-visit h3{font-size:14px;margin-bottom:10px}.before-visit p{font-size:13px;line-height:1.8;color:var(--color-text-muted);margin-bottom:14px}.before-visit a{font-size:13px;text-decoration:underline;text-underline-offset:4px}iframe{display:block;width:100%;height:100%;min-height:440px;border:0;background:#edf1f6}a:focus-visible,summary:focus-visible{outline:2px solid var(--color-accent);outline-offset:5px}a:hover{text-decoration:underline;text-underline-offset:4px}
@media(max-width:760px){.wrap{width:calc(100% - 40px)}.hero-grid{grid-template-columns:1fr;gap:16px;padding-block:36px 76px}.hospital-art{max-width:280px;justify-self:center}.intro{font-size:16px}.contact-cards{grid-template-columns:1fr;gap:18px;margin-top:-36px}.contact-card{padding:28px 24px;min-height:0}.visit{padding-block:48px}.visit-heading{margin-bottom:28px}.visit-grid{grid-template-columns:1fr}.visit-copy{padding:28px}iframe{height:340px;min-height:340px}}
@media(prefers-reduced-motion:reduce){.email-button{transition:none}}
.contact-card :is(h2,.phone,.email-address),.visit :is(h2,h3,a){color:var(--color-primary)}
.contact-hero .eyebrow{color:#d5e1f1}
</style>
