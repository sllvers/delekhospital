---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import elders from '../assets/elder-care.jpg';
import exterior from '../assets/hospital-exterior.jpg';
import teaching from '../assets/clinical-teaching.jpg';
import { stories, news } from '../data/editorial';
import '../styles/home-community.css';
const values = [
  { title: 'People-centred care', text: 'Serving our diverse community with dignity, kindness and respect.', icon: 'people' },
  { title: 'Essential services', text: 'Outpatient and inpatient care, diagnostics, pharmacy and laboratory.', icon: 'care' },
  { title: 'Care beyond the hospital', text: 'Prevention, public health and education connect people with care.', icon: 'heart' },
  { title: 'Supported by donors', text: 'Your support helps sustain affordable healthcare and community services.', icon: 'leaf' },
];
const figures = ['Hospital beds', 'Annual outpatient visits', 'Annual inpatient admissions', 'People vaccinated', 'Hospital team'];
const story = stories[0];
---
<BaseLayout title="Delek Hospital — Compassionate Care in Dharamshala">
<div class="community-home">
  <section class="community-hero" aria-labelledby="home-title">
    <Picture src={elders} formats={['avif','webp']} widths={[640,960,1440,1920]} sizes="100vw" alt="A healthcare worker caring for an older patient" loading="eager" fetchpriority="high" />
    <div class="community-width hero-copy">
      <p class="home-eyebrow">Delek Hospital · Dharamshala</p>
      <h1 id="home-title">Community care<br />in the Himalayas.</h1>
      <p>Accessible, compassionate healthcare for Tibetan refugees and the local communities of Dharamshala.</p>
      <div class="home-actions"><a class="home-button home-donate" href="/support/"><span aria-hidden="true">♡</span> Donate now</a><a class="home-button home-outline" href="/find-care/services/">Our services <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="home-values" aria-label="Care at Delek"><div class="community-width values-grid">
    {values.map(value => <article>
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        {value.icon==='people' && <><circle cx="24" cy="12" r="6"/><circle cx="8" cy="17" r="4"/><circle cx="40" cy="17" r="4"/><path d="M14 40V31a10 10 0 0 1 20 0v9H14ZM14 26a8 8 0 0 0-13 6v8h10m23-14a8 8 0 0 1 13 6v8H37"/></>}
        {value.icon==='care' && <><path d="M9 5v13a11 11 0 0 0 22 0V5M9 7h6m16 0h-6M20 29v5a9 9 0 0 0 18 0v-8"/><circle cx="38" cy="21" r="5"/></>}
        {value.icon==='heart' && <><path d="M24 24 12 13a7 7 0 0 1 12-7 7 7 0 0 1 12 7L24 24ZM20 44V33l-8-9a3 3 0 0 0-4 4l5 7M8 27V18a3 3 0 0 0-6 0v16l10 10m16 0V33l8-9a3 3 0 0 1 4 4l-5 7m5-8V18a3 3 0 0 1 6 0v16L36 44"/></>}
        {value.icon==='leaf' && <><path d="M9 35C-1 11 23 6 43 3c-1 22-7 39-28 34M5 45 32 16m-13 13-2-9m8 3 10 1"/></>}
      </svg><div><h2>{value.title}</h2><p>{value.text}</p></div>
    </article>)}
  </div></section>

  <section class="home-impact community-width" aria-labelledby="impact-title">
    <div><h2 id="impact-title">Our impact at a glance</h2><p>Care in the hospital.<br />Support in the community.</p><p class="confirmation-note">Figures awaiting hospital confirmation.</p></div>
    <dl>{figures.map(label => <div><dt>{label}</dt><dd aria-label="Awaiting confirmation">—</dd></div>)}</dl>
  </section>

  <section class="home-involvement community-width" aria-label="Our community">
    <article class="home-story">
      <Picture src={exterior} formats={['avif','webp']} widths={[360,640,900]} sizes="(max-width: 700px) 100vw, 25vw" alt="Delek Hospital and the surrounding hills of Dharamshala" loading="lazy" />
      <div><p class="home-eyebrow">{story ? 'Patient & community story' : 'People at the heart of care'}</p>
        <h2>{story?.title ?? 'Every person deserves dignity, kindness and respect.'}</h2>
        <p>{story?.excerpt ?? 'Everyone who comes through our doors deserves compassionate care, regardless of their background or financial circumstances.'}</p>
        {!story && <p class="confirmation-note">Patient story awaiting approval and publication consent.</p>}
        <a class="home-button home-secondary" href={story ? `/impact-stories/${story.slug}/` : '/about/'}>{story ? 'Read their story' : 'About Delek'} <span aria-hidden="true">→</span></a>
      </div>
    </article>
    <article class="home-partner">
      <Picture src={teaching} formats={['avif','webp']} widths={[480,800,1200]} sizes="(max-width: 900px) 100vw, 40vw" alt="A visiting specialist sharing expertise with Delek doctors" loading="lazy" />
      <div><h2>Share your expertise.</h2><p>Clinical work, teaching and institutional partnerships help strengthen care for the future.</p><a class="home-button home-light" href="/partner-with-us/">Partner with us <span aria-hidden="true">→</span></a></div>
    </article>
  </section>

  <nav class="home-quicklinks community-width" aria-label="Plan your visit"><h2>Here when you need us.</h2><a href="/find-care/schedules/">Clinics & schedules <span aria-hidden="true">→</span></a><a href="/find-care/tb-care/">TB care <span aria-hidden="true">→</span></a><a href="/find-care/locations/">Directions & locations <span aria-hidden="true">→</span></a><a href="/contact/">Contact Delek <span aria-hidden="true">→</span></a></nav>
  {news.length>0 && <section class="home-news community-width"><h2>News & updates</h2><div>{news.slice(0,3).map(item=><a href={`/news/${item.slug}/`}><time datetime={item.date}>{item.date}</time><h3>{item.title}</h3><p>{item.summary}</p></a>)}</div></section>}
</div>
</BaseLayout>
