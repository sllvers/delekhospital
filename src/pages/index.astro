---
import BaseLayout from '../layouts/BaseLayout.astro';
import exterior from '../assets/hospital-exterior.jpg';
import elders from '../assets/elder-care.jpg';
import outreach from '../assets/tb-outreach.jpg';
import { stories, news } from '../data/editorial';
import { programs } from '../data/programs';
---
<BaseLayout title="Delek Hospital — Compassionate Care in Dharamshala">
<div class="home-editorial">
<header class="home-opening page-width"><div class="opening-top"><p class="label">Dharamshala, India / Since 1971</p><a class="quiet-link" href="/find-care/schedules">Clinic hours <span aria-hidden="true">↗</span></a></div><div class="opening-title"><h1>Care, rooted<br />in compassion.</h1><div class="opening-aside"><p>Accessible healthcare for Tibetan refugees and the local communities of Dharamshala.</p><div class="opening-actions"><a class="primary-link" href="/find-care">Find care <span aria-hidden="true">↗</span></a><a class="quiet-link" href="/support">Support Delek <span aria-hidden="true">↗</span></a></div></div></div></header>
<figure class="hospital-panorama"><img src={exterior.src} width={exterior.width} height={exterior.height} alt="Delek Hospital and the surrounding hills of Dharamshala at sunset" fetchpriority="high" /><figcaption><span>Delek Hospital</span><span>Gangchen Kyishong, Dharamshala</span></figcaption></figure>
<nav class="patient-links page-width" aria-label="Patient quick links"><a href="/find-care/schedules">Clinics & schedules <span aria-hidden="true">↗</span></a><a href="/find-care/services">Medical services <span aria-hidden="true">↗</span></a><a href="/find-care/tb-care">TB care <span aria-hidden="true">↗</span></a><a href="/find-care/locations">Directions <span aria-hidden="true">↗</span></a></nav>
<section class="mission page-width" aria-labelledby="mission-title"><div class="mission-copy"><p class="label">Our purpose</p><h2 id="mission-title">Every person.<br />Every act of care.</h2><p>Everyone who comes through our doors deserves dignity, kindness and respect, regardless of their background or financial circumstances.</p><p>For more than five decades, that belief has shaped Delek’s work in the hospital and beyond.</p><a class="line-link" href="/about">Get to know Delek <span aria-hidden="true">↗</span></a><div class="small-links"><a href="/milestones">Our history ↗</a><a href="/team">Meet our team ↗</a></div></div><figure class="mission-photo home-photo"><img src={elders.src} width={elders.width} height={elders.height} alt="A healthcare worker checking an older woman’s finger with a pulse oximeter" loading="lazy" /><figcaption>Care reaching across generations.</figcaption></figure></section>
<section class="impact-section" aria-labelledby="impact-title"><div class="page-width"><div class="impact-heading"><p class="label">Beyond our hospital</p><div><h2 id="impact-title">Closer to the<br />communities we serve.</h2><p>Prevention, public health and education connect people with care.</p></div></div><figure class="outreach-photo home-photo"><img src={outreach.src} width={outreach.width} height={outreach.height} alt="Healthcare workers carrying out outdoor community screening in a courtyard" loading="lazy" /><figcaption>Community screening and outreach.</figcaption></figure><div class="programs"><div><p class="label">Our areas of work</p><a class="quiet-link" href="/our-impact">Explore our impact <span aria-hidden="true">↗</span></a></div><div>{programs.slice(0,3).map((program,index)=><a class="program-link" href={`/our-impact/${program.slug}`}><span class="number" aria-hidden="true">0{index+1}</span><div><h3>{program.title}</h3><p>{program.summary}</p></div><span aria-hidden="true">↗</span></a>)}</div></div></div></section>
{stories.length>0&&<section class="updates page-width"><p class="label">Patient & community stories</p><h2>The people behind the care.</h2><div class="update-list">{stories.slice(0,3).map(story=><a href={`/impact-stories/${story.slug}`}><h3>{story.title}</h3><p>{story.excerpt}</p><span>Read story ↗</span></a>)}</div></section>}
<section class="participate"><div class="page-width"><p class="label">A shared commitment</p><h2>Help care continue.</h2><div class="participation-options"><div><h3>Support Delek.</h3><p>Your support helps sustain affordable healthcare, medicines, screening and community services.</p><a class="line-link" href="/support">Ways to give <span aria-hidden="true">↗</span></a></div><div><h3>Share your expertise.</h3><p>Clinical work, teaching and institutional partnerships help strengthen care for the future.</p><a class="line-link" href="/partner-with-us">Partner with us <span aria-hidden="true">↗</span></a></div></div></div></section>
{news.length>0&&<section class="updates page-width"><p class="label">Latest from Delek</p><h2>Hospital & community updates.</h2><div class="update-list">{news.slice(0,3).map(item=><a href={`/news/${item.slug}`}><time datetime={item.date}>{item.date}</time><h3>{item.title}</h3><p>{item.summary}</p><span>Read update ↗</span></a>)}</div><a class="quiet-link" href="/news">All news & updates ↗</a></section>}
<section class="visit page-width"><div><p class="label">Visit Delek</p><h2>Here in Dharamshala.</h2></div><div><p>Gangchen Kyishong, District Kangra<br />Himachal Pradesh, India – 176215</p><a class="line-link" href="/find-care/locations">Directions & locations <span aria-hidden="true">↗</span></a><div class="small-links"><a href="tel:+911892222053">+91 1892 222053</a><a href="/contact">Contact us ↗</a></div></div></section>
</div>
</BaseLayout>
<style>
.home-editorial{--ink:#263c31;--paper:#f3f0e8;color:var(--ink);background:var(--paper)}.page-width{width:min(100% - 96px,1240px);margin-inline:auto}.label{font-size:11px;line-height:1.6;font-weight:500;letter-spacing:.16em;text-transform:uppercase;margin-bottom:24px}.home-opening{padding-block:32px 48px}.opening-top{display:flex;justify-content:space-between;align-items:baseline;gap:24px}.opening-title{display:grid;grid-template-columns:1.6fr 1fr;gap:48px;align-items:end}.opening-title h1{font-family:Georgia,serif;font-size:clamp(58px,7.7vw,114px);line-height:1.01;font-weight:400;letter-spacing:-.045em}.opening-aside{padding-bottom:8px}.opening-aside>p{font-size:17px;line-height:1.75;max-width:35ch}.opening-actions{display:flex;align-items:center;gap:28px;flex-wrap:wrap;margin-top:28px}.primary-link{display:inline-flex;justify-content:space-between;gap:36px;background:var(--ink);color:#fffdf5;padding:16px 20px;font-size:14px}.quiet-link{display:inline-flex;gap:28px;align-items:center;font-size:14px;border-bottom:1px solid #8b9a8a;padding-bottom:8px}.hospital-panorama{position:relative;margin:0}.hospital-panorama img{width:100%;height:clamp(340px,43vw,620px);object-fit:cover;object-position:center 53%;display:block}.hospital-panorama figcaption{position:absolute;bottom:0;left:0;right:0;color:white;padding:44px 48px 20px;background:linear-gradient(transparent,rgba(15,30,20,.6));display:flex;justify-content:space-between;font-size:11px;letter-spacing:.04em}.patient-links{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid #b8c0b1;padding-block:8px}.patient-links a{display:flex;justify-content:space-between;gap:16px;padding:22px 24px;border-right:1px solid #c6cbbf;font-size:14px}.patient-links a:first-child{padding-left:0}.patient-links a:last-child{border-right:0;padding-right:0}.mission{display:grid;grid-template-columns:1fr 1.2fr;gap:100px;align-items:center;padding-block:96px}.home-editorial h2{font-family:Georgia,serif;font-size:clamp(36px,4.5vw,64px);font-weight:400;letter-spacing:-.035em;line-height:1.08}.mission-copy h2{margin-bottom:28px}.mission-copy>p:not(.label){font-size:17px;line-height:1.8;color:#586357;margin-bottom:16px}.line-link{display:flex;justify-content:space-between;gap:24px;padding:18px 0;border-bottom:1px solid #a7b2a3;font-size:14px}.small-links{display:flex;flex-wrap:wrap;gap:24px;font-size:13px;margin-top:22px}.small-links a{text-decoration:underline;text-underline-offset:5px}figure{margin:0}figure img{display:block;width:100%;object-fit:cover}.mission-photo img{aspect-ratio:5/6;object-position:55% center}figcaption{font-size:11px;color:#586357;line-height:1.6;padding-top:12px}.impact-section{padding-block:72px;background:#e2e5d9}.impact-heading{display:grid;grid-template-columns:1fr 2fr;gap:48px;align-items:start;margin-bottom:40px}.impact-heading .label{padding-top:8px}.impact-heading h2{margin-bottom:24px}.impact-heading p:not(.label){font-size:17px;line-height:1.7;color:#586357}.outreach-photo img{aspect-ratio:2.1/1;object-position:center 48%}.programs{display:grid;grid-template-columns:1fr 2fr;gap:48px;margin-top:48px}.program-link{display:grid;grid-template-columns:24px 1fr 20px;gap:24px;border-top:1px solid #aeb9a5;padding:24px 0}.number{font-size:11px;padding-top:6px}.program-link h3{font-size:22px;font-weight:500;line-height:1.3;margin-bottom:8px}.program-link p{font-size:14px;line-height:1.7;color:#586357}.participate{background:var(--ink);color:#fffdf5;padding-block:72px}.participate .label{color:#d0d9c7}.participation-options{display:grid;grid-template-columns:1fr 1fr;gap:100px;margin-top:48px}.participation-options h3{font-family:Georgia,serif;font-size:32px;font-weight:400;margin-bottom:20px}.participation-options p{color:#e0e5d9;font-size:16px;line-height:1.8;max-width:42ch}.participation-options .line-link{margin-top:16px;border-color:#758674}.participate a:focus-visible{outline-color:white}.visit{display:grid;grid-template-columns:1.2fr 1fr;gap:64px;padding-block:72px}.visit h2{font-size:clamp(36px,4vw,52px)}.visit p:not(.label){font-size:16px;line-height:1.8}.updates{padding-block:64px}.update-list{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;margin-block:32px}.update-list a{border-top:1px solid #b8c0b1;padding-top:24px}.update-list h3{font-size:24px;margin-bottom:16px}.update-list p{font-size:15px;line-height:1.7;margin-bottom:24px}.update-list span,.update-list time{font-size:12px}.primary-link span,.quiet-link span,.line-link span,.patient-links span,.program-link>span:last-child{transition:transform .2s ease}a:hover>span:last-child{transform:translate(3px,-3px)}.home-photo.entered{animation:photo-in .4s ease-out both}@keyframes photo-in{from{opacity:.65;transform:translateY(10px)}to{opacity:1;transform:none}}
@media(max-width:950px){.opening-title{grid-template-columns:1.3fr 1fr;gap:32px}.opening-actions{gap:16px}.mission{gap:48px}.participation-options{gap:48px}.patient-links a{font-size:12px;padding-inline:16px}}
@media(max-width:767px){.page-width{width:calc(100% - 40px)}.home-opening{padding-block:24px 32px}.opening-top .label{font-size:9px}.opening-top .quiet-link{font-size:12px;gap:12px;white-space:nowrap}.opening-title{grid-template-columns:1fr;gap:24px}.opening-title h1{font-size:clamp(48px,12vw,72px)}.opening-aside>p{font-size:16px}.opening-actions{margin-top:20px;gap:24px}.hospital-panorama img{height:340px;object-position:58% center}.hospital-panorama figcaption{padding:36px 20px 16px;gap:16px;font-size:9px}.patient-links{grid-template-columns:1fr 1fr}.patient-links a,.patient-links a:first-child,.patient-links a:last-child{padding:18px 12px;font-size:12px;border-right:0}.patient-links a:nth-child(odd){padding-left:0;border-right:1px solid #c6cbbf}.patient-links a:nth-child(even){padding-right:0}.patient-links a:nth-child(-n+2){border-bottom:1px solid #c6cbbf}.mission,.impact-heading,.programs,.participation-options,.visit,.update-list{grid-template-columns:1fr;gap:28px}.mission{padding-block:48px}.mission-photo img{aspect-ratio:4/3}.mission-copy>p:not(.label){font-size:16px}.impact-section,.participate{padding-block:48px}.impact-heading .label{margin:0;padding:0}.impact-heading{margin-bottom:28px}.outreach-photo img{aspect-ratio:4/3}.programs{margin-top:28px}.program-link{gap:16px}.program-link h3{font-size:20px}.participation-options{margin-top:32px;gap:40px}.participation-options h3{font-size:28px}.visit{padding-block:48px}.updates{padding-block:48px}}
@media(prefers-reduced-motion:reduce){.home-photo.entered{animation:none}.home-editorial a span{transition:none;transform:none!important}}
</style>
<script>
document.addEventListener('astro:page-load',()=>{
 if(matchMedia('(prefers-reduced-motion: reduce)').matches)return;
 const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('entered');observer.unobserve(entry.target);}}),{threshold:.1});
 document.querySelectorAll('.home-photo').forEach(photo=>observer.observe(photo));
 document.addEventListener('astro:before-swap',()=>observer.disconnect(),{once:true});
});
</script>
