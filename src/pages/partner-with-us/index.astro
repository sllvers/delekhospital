---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import photo from '../../assets/partners/community.jpg';
import '../../styles/partners.css';
---
<BaseLayout title="Partner with us — Delek Hospital" description="Share knowledge and strengthen care through clinical, educational and institutional partnerships.">
<div class="partner-page">
<header class="partner-hero"><div class="partner-wrap partner-hero-grid"><div><p class="partner-label">Working together / Delek Hospital</p><h1>Partner with us</h1><p class="partner-intro">Share knowledge and strengthen care through clinical, educational and institutional partnerships.</p><a class="hero-jump" href="#partnership-information">Explore the details ↓</a></div><figure><Image src={photo} alt="Delek staff gathered for a group photograph" widths={[480,800,1100]} sizes="(max-width: 760px) 100vw, 45vw" loading="eager" /><figcaption>Hospital archive · The Delek team</figcaption></figure></div></header>
<section id="partnership-information" class="partner-wrap partner-cards three-cards" aria-label="Partnership information"><article class="partner-card"><h2>Visiting medical specialists</h2><p>Contribute clinical expertise, mentorship and teaching alongside Delek’s doctors and nurses.</p><a class="partner-link" href="/partner-with-us/visiting-specialists">Explore specialist placements <span aria-hidden="true">↗</span></a></article><article class="partner-card"><h2>Clinical observerships</h2><p>Learn about community healthcare through an educational observation placement.</p><a class="partner-link" href="/partner-with-us/observerships">Explore observerships <span aria-hidden="true">↗</span></a></article><article class="partner-card"><h2>Institutional partnerships</h2><p>Collaborate in clinical care, medical education, research and public health.</p><a class="partner-link" href="/partner-with-us/institutions">Explore partnerships <span aria-hidden="true">↗</span></a></article></section>
<section class="partner-wrap partner-enquiry" aria-labelledby="enquiry-heading"><div><p class="partner-label">Next step</p><h2 id="enquiry-heading">Not sure where to start?</h2><p>Tell us about your experience or organization and how you would like to contribute.</p></div><div class="partner-enquiry-actions"><a class="partner-button" href="mailto:hospitaldelek@yahoo.com?subject=Partnership%20enquiry">Email the hospital <span aria-hidden="true">↗</span></a><span class="email-hint">Opens your email app</span><a class="partner-contact" href="/contact">Other ways to contact us →</a></div></section>
</div></BaseLayout>
