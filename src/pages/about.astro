---
import BaseLayout from '../layouts/BaseLayout.astro';
import archive from '../assets/archive-care.jpg';
import consultation from '../assets/clinical-consultation.jpg';
import '../styles/editorial.css';
const values=[['Compassion & respect','Care delivered with kindness, understanding and respect for every person’s dignity.'],['Equity & service','Accessible care and a commitment to serving the community to the best of our ability.'],['Community','Trust, education and outreach that connect people with healthcare.']];
---
<BaseLayout title="About Delek Hospital" description="Discover Delek Hospital’s history and commitment to compassionate, accessible healthcare in Dharamshala.">
<div class="editorial-page">
<header class="ed-intro ed-wrap"><p class="ed-label">About Delek / Since 1971</p><div class="ed-intro-grid"><h1>A hospital.<br />A community.<br />A continuing purpose.</h1><p>For more than five decades, Delek has served Tibetan refugees and the wider local community, bringing compassion, dignity and respect to patient care.</p></div></header>
<section class="beginnings ed-wrap" aria-labelledby="beginnings-title"><figure class="archive"><img src={archive.src} width={archive.width} height={archive.height} alt="Archival black-and-white photograph of a child drinking from a cup beside a Red Cross supply box" /><figcaption>From the hospital’s collection · Date unknown</figcaption></figure><div class="ed-copy"><p class="ed-label">Our beginnings</p><h2 id="beginnings-title">Rooted in<br />a need for care.</h2><p>Mr. Tsewang Rinchen Rishing proposed a dedicated medical clinic to serve the Tibetan refugee community in Dharamshala. Delek Hospital opened in 1971 with the blessing of His Holiness the XIV Dalai Lama.</p><p>That commitment continues through clinical care, prevention, screening, education and community outreach.</p><a class="ed-link" href="/milestones">Explore our history <span aria-hidden="true">↗</span></a></div></section>
<section class="mission-band" id="mission"><div class="ed-wrap"><div class="mission-heading"><p class="ed-label">Our mission</p><div><h2>Care with dignity.<br />For everyone.</h2><p>We are committed to serving all who come to us, regardless of race, religion, gender or country of origin. We strive to offer the finest treatment possible within our resources, with compassion and respect regardless of social or financial circumstances.</p></div></div><div class="values">{values.map(([title,description],index)=><article><span class="ed-label" aria-hidden="true">0{index+1}</span><h3>{title}</h3><p>{description}</p></article>)}</div></div></section>
<section class="people ed-wrap"><div class="ed-copy"><p class="ed-label">Delek today</p><h2>A commitment<br />carried by people.</h2><p>Meet the people contributing to Delek’s patient care and daily work, and explore the programs that connect the hospital with its communities.</p><a class="ed-link" href="/team">Meet our team <span aria-hidden="true">↗</span></a><a class="ed-link" href="/our-impact">See our community work <span aria-hidden="true">↗</span></a></div><figure><img src={consultation.src} width={consultation.width} height={consultation.height} alt="A clinician examining a child with a stethoscope while another healthcare worker assists" loading="lazy" /><figcaption>Clinical care at Delek Hospital.</figcaption></figure></section>
<aside class="ed-closing"><div class="ed-wrap"><div><p class="ed-label">A shared future</p><h2>Be part of<br />Delek’s story.</h2></div><div><p>Support accessible care or share your expertise through a clinical, educational or institutional partnership.</p><a class="ed-link" href="/support">Support Delek <span aria-hidden="true">↗</span></a><a class="ed-link" href="/partner-with-us">Partner with us <span aria-hidden="true">↗</span></a></div></div></aside>
</div></BaseLayout>
<style>
.beginnings{display:grid;grid-template-columns:1.2fr 1fr;gap:88px;align-items:center;padding-block:16px 88px}.archive{padding:20px;background:#e8e4d9}.archive img{filter:sepia(.08)}.mission-band{background:var(--color-surface-alt);padding-block:64px}.mission-heading{display:grid;grid-template-columns:1fr 2fr;gap:48px}.mission-heading h2{margin-bottom:24px}.mission-heading p:not(.ed-label){font-size:18px;line-height:1.8;max-width:65ch;color:var(--color-text-muted)}.values{display:grid;grid-template-columns:repeat(3,1fr);gap:48px;margin-top:48px}.values article{border-top:1px solid var(--color-border);padding-top:24px}.values h3{font-size:23px;font-weight:500;line-height:1.3;margin-bottom:16px}.values p{font-size:15px;line-height:1.8;color:var(--color-text-muted)}.people{display:grid;grid-template-columns:1fr 1.35fr;gap:88px;align-items:center;padding-block:88px}.people img{aspect-ratio:4/3}
@media(max-width:767px){.beginnings,.mission-heading,.people,.values{grid-template-columns:1fr;gap:28px}.beginnings{padding-bottom:48px}.archive{padding:12px}.mission-band{padding-block:40px}.mission-heading .ed-label{margin:0}.mission-heading p:not(.ed-label){font-size:16px}.values{margin-top:32px}.values article>.ed-label{margin-bottom:12px}.people{padding-block:48px}.people figure{grid-row:1}}
</style>
