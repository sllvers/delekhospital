---
import BaseLayout from '../layouts/BaseLayout.astro';
import hospital from '../assets/hospital-exterior.jpg';
const donationUrl = 'https://www.paypal.com/donate/?hosted_button_id=9FRFJXDYCWULS';
const areas = [
  ['Community & TB care', 'Support diagnosis, treatment, prevention and continued care beyond the hospital.'],
  ['Medical equipment', 'Help maintain the tools and diagnostic services that support everyday care.'],
  ['Hospital facilities', 'Support the upkeep and improvement of spaces where patients receive care.'],
  ['Our healthcare team', 'Help sustain the doctors, nurses and support staff who make this work possible.'],
];
---
<BaseLayout title="Support Delek — Delek Hospital" description="Help Delek Hospital continue compassionate, accessible care. Learn where your support goes and donate through PayPal.">
  <section class="giving-hero content-wrap">
    <div class="giving-intro"><span class="eyebrow">Support Delek</span><h1>Help us keep<br />care within reach.</h1><p>Compassionate care needs a community behind it. Your support helps Delek continue serving Tibetan refugees and the wider communities of Dharamshala.</p><div class="actions"><a class="button" href={donationUrl}>Donate via PayPal <span aria-hidden="true">↗</span></a><a class="giving-jump" href="#your-support">Where your support goes ↓</a></div></div>
    <figure><img src={hospital.src} width={hospital.width} height={hospital.height} alt="Delek Hospital and the surrounding hills of Dharamshala at sunset" fetchpriority="high" /><figcaption>A place of care in Dharamshala, serving the community since 1971.</figcaption></figure>
  </section>
  <section class="giving-purpose"><div class="content-wrap purpose-inner"><span class="eyebrow">Why give</span><p>Every person deserves to be cared for with <em>dignity, kindness and respect.</em> Your generosity helps us carry that commitment forward.</p></div></section>
  <section class="content-wrap giving-allocation" id="your-support"><div class="allocation-heading"><span class="eyebrow">Your contribution</span><h2>One hospital.<br />Many ways to help.</h2><p>Supporting the people, services and spaces that make accessible healthcare possible.</p></div><div class="allocation-list">{areas.map(([title,description],i) => <article><span class="allocation-number" aria-hidden="true">0{i+1}</span><div><h3>{title}</h3><p>{description}</p></div></article>)}</div></section>
  <section class="giving-close"><div class="content-wrap close-inner"><div><span class="eyebrow">Give with care</span><h2>Be part of Delek’s<br />next chapter.</h2><p>Help sustain affordable healthcare, essential medicines and community health services.</p><div class="actions"><a class="button" href={donationUrl}>Donate via PayPal ↗</a></div></div><aside><h3>Have a question about giving?</h3><p>For a larger contribution, a proposed partnership or questions about supporting the hospital, please speak with our team.</p><a class="text-link" href="/contact">Contact Delek →</a><a class="text-link" href="/partner-with-us">Explore partnerships →</a></aside></div></section>
</BaseLayout>
<style>
.giving-hero{display:grid;grid-template-columns:1.1fr 1fr;gap:64px;align-items:center;padding-block:80px}.giving-intro h1{font-size:clamp(42px,5.2vw,70px);line-height:1.06;letter-spacing:-.045em;font-weight:600;margin-bottom:28px}.giving-intro p{font-size:18px;line-height:1.8;color:var(--color-text-muted);max-width:47ch}.giving-intro .actions{align-items:center}.giving-jump{font-size:14px;text-decoration:underline;text-underline-offset:5px}.button{gap:20px}.giving-hero figure{margin:0}.giving-hero img{width:100%;height:480px;object-fit:cover;border-radius:120px 12px 12px 12px}.giving-hero figcaption{font-size:12px;line-height:1.6;color:var(--color-text-muted);margin-top:14px}.giving-purpose{padding-block:64px;background:var(--color-surface-alt)}.purpose-inner{display:grid;grid-template-columns:1fr 3fr;gap:40px}.purpose-inner p{font-size:clamp(25px,3vw,38px);line-height:1.4;letter-spacing:-.02em;max-width:38ch}.purpose-inner em{font-family:Georgia,serif;color:var(--color-accent)}.giving-allocation{padding-block:88px;display:grid;grid-template-columns:1fr 1.5fr;gap:100px;scroll-margin-top:100px}h2{font-size:clamp(30px,3.5vw,46px);font-weight:600;line-height:1.15;letter-spacing:-.03em;margin-bottom:24px}.allocation-heading p,.allocation-list p,.giving-close p{color:var(--color-text-muted);line-height:1.8}.allocation-list article{display:flex;gap:28px;padding-block:28px;border-top:1px solid #dcded4}.allocation-list article:first-child{padding-top:0;border:0}.allocation-number{font-size:13px;color:var(--color-accent);padding-top:5px}.allocation-list h3{font-size:22px;font-weight:500;margin-bottom:8px}.giving-close{padding-block:72px;background:#e9ede5}.close-inner{display:grid;grid-template-columns:1.5fr 1fr;gap:100px;align-items:center}.close-inner aside{padding-left:40px;border-left:1px solid #c9d0c3}.close-inner h3{font-weight:600;font-size:20px;margin-bottom:16px}.close-inner .text-link{display:block;margin-top:20px}
@media(max-width:767px){.giving-hero{grid-template-columns:1fr;padding-block:48px;gap:36px}.giving-hero img{height:320px;border-top-left-radius:72px}.purpose-inner,.giving-allocation,.close-inner{grid-template-columns:1fr;gap:24px}.giving-purpose,.giving-close{padding-block:40px}.giving-allocation{padding-block:48px;gap:36px}.close-inner aside{border-left:0;border-top:1px solid #c9d0c3;padding:28px 0 0}.giving-intro .actions{align-items:flex-start;flex-direction:column}}
</style>
