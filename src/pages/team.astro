---
import BaseLayout from '../layouts/BaseLayout.astro';

const administration = [
  { name: 'Mr. Dawa Phunkyi', role: 'Administrator' },
  { name: 'Mr. Tashi Dhondup', role: 'Administration' },
  { name: 'Mr. Tsering Damdhul', role: 'Administration' },
  { name: 'Mr. Tenzin Shenyen', role: 'Administration' }
];

const seniorMedicalOfficers = [
  { 
    name: 'Dr. Tsetan Dorji', 
    role: 'Senior Medical Officer',
    bio: 'Dedicated clinical care and community health service.'
  },
  { 
    name: 'Dr. Sonam Topgyal', 
    role: 'Senior Medical Officer',
    bio: 'Committed to comprehensive patient diagnosis and treatment.'
  },
  { 
    name: 'Dr. Tenzin Namdon', 
    role: 'Senior Medical Officer',
    school: 'TCV Gopalpur / St. John\'s Medical College',
    joined: 'Joined Delek in 2017',
    bio: 'I was born in India, in the Bylakkupe settlement. I knew I wanted to be a doctor from ......'
  },
  { 
    name: 'Dr. Jigme Kalsang', 
    role: 'Senior Medical Officer',
    bio: 'Specialized medical care and acute intervention.'
  }
];
---

<BaseLayout title="Our Medical Team — Tibetan Delek Hospital">
  <div class="max-w-[1400px] mx-auto px-[var(--space-6)] py-[var(--space-16)]">
    <!-- Header -->
    <div class="max-w-2xl mb-[var(--space-16)] reveal">
      <span class="text-[var(--font-size-xs)] uppercase tracking-[0.2em] text-[var(--color-text-muted)] mb-[var(--space-2)] block">
        Hospital Leadership & Staff
      </span>
      <h1 class="text-[var(--font-size-4xl)] md:text-[var(--font-size-5xl)] font-[var(--font-weight-semibold)] tracking-tight text-[var(--color-primary)] mb-[var(--space-4)]">
        Our Administration & Medical Officers
      </h1>
      <p class="text-[var(--font-size-base)] text-[var(--color-text-muted)] leading-[var(--leading-relaxed)]">
        Meet the dedicated team guiding Tibetan Delek Hospital's mission of compassionate, accessible healthcare in Dharamsala.
      </p>
    </div>

    <!-- Senior Medical Officers Section -->
    <div class="mb-[var(--space-16)]">
      <h2 class="text-[var(--font-size-2xl)] font-[var(--font-weight-semibold)] text-[var(--color-primary)] mb-[var(--space-8)] reveal">
        Senior Medical Officers
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-[var(--space-6)]">
        {seniorMedicalOfficers.map((doc, idx) => (
          <div class="reveal p-[var(--space-6)] rounded-[var(--radius-lg)] bg-[var(--color-surface-alt)] border border-[var(--color-surface-alt)] hover-lift flex flex-col justify-between" data-reveal-delay={idx * 80}>
            <div>
              <div class="flex items-center justify-between mb-[var(--space-2)]">
                <span class="text-[var(--font-size-xs)] uppercase tracking-[0.15em] text-[var(--color-text-muted)]">
                  {doc.role}
                </span>
                {doc.joined && (
                  <span class="text-[var(--font-size-xs)] text-[var(--color-text-muted)] font-[var(--font-weight-medium)]">
                    {doc.joined}
                  </span>
                )}
              </div>
              <h3 class="text-[var(--font-size-xl)] font-[var(--font-weight-semibold)] text-[var(--color-primary)] mb-[var(--space-2)]">
                {doc.name}
              </h3>
              {doc.school && (
                <div class="text-[var(--font-size-xs)] text-[var(--color-primary-muted)] mb-[var(--space-3)]">
                  {doc.school}
                </div>
              )}
              <p class="text-[var(--font-size-sm)] text-[var(--color-text-muted)] leading-[var(--leading-relaxed)] italic">
                "{doc.bio}"
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Administration Section -->
    <div>
      <h2 class="text-[var(--font-size-2xl)] font-[var(--font-weight-semibold)] text-[var(--color-primary)] mb-[var(--space-8)] reveal">
        Administration
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-[var(--space-6)]">
        {administration.map((admin, idx) => (
          <div class="reveal p-[var(--space-6)] rounded-[var(--radius-lg)] bg-[var(--color-surface-alt)] border border-[var(--color-surface-alt)] hover-lift" data-reveal-delay={idx * 60}>
            <span class="text-[var(--font-size-xs)] uppercase tracking-[0.15em] text-[var(--color-text-muted)] mb-[var(--space-1)] block">
              {admin.role}
            </span>
            <h3 class="text-[var(--font-size-lg)] font-[var(--font-weight-semibold)] text-[var(--color-primary)]">
              {admin.name}
            </h3>
          </div>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
