---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import { locations } from '../../data/locations';
import hospital from '../../assets/opd-entrance.jpg';
import branch from '../../assets/branch-waiting-area.jpg';
import hostel from '../../assets/chandigarh-hostel.jpg';
const facilityPhotos = {
 'main-hospital': {image:hospital,alt:'Entrance to the Delek Hospital OPD building',caption:'The OPD entrance at Delek Hospital.'},
 'mcleod-ganj': {image:branch,alt:'Covered waiting area with benches at the branch clinic',caption:'Branch clinic waiting area · Client-supplied photograph.'},
 'chandigarh': {image:hostel,alt:'Exterior of the yellow two-storey Delek patient hostel building',caption:'Delek’s patient hostel in Chandigarh.'},
};

---
<BaseLayout title="Our Locations — Delek Hospital" description="Choose a Delek facility to find services, contact information and directions."><div class="content-wrap"><PageIntro eyebrow="Find Care" title="Find your way to Delek." description="Choose a facility for practical information, available services and help planning your visit." />
<div class="location-explorer" data-locations>
 <nav class="location-picker" aria-label="Choose a facility" hidden>{locations.map((location,index)=><button type="button" aria-pressed={index===0?'true':'false'} aria-controls={`location-${location.id}`} data-location={location.id}><span class="place-name">{location.place}</span><span class="place-type">{location.label}</span><span class="place-arrow" aria-hidden="true">↗</span></button>)}</nav>
 <div class="location-panels">{locations.map(location=><section id={`location-${location.id}`} data-location-panel={location.id} class="location-panel"><span class="eyebrow">{location.label}</span><h2>{location.name}</h2><p>{location.description}</p>{facilityPhotos[location.id as keyof typeof facilityPhotos] && <figure class="facility-photo"><img src={facilityPhotos[location.id as keyof typeof facilityPhotos].image.src} width={facilityPhotos[location.id as keyof typeof facilityPhotos].image.width} height={facilityPhotos[location.id as keyof typeof facilityPhotos].image.height} alt={facilityPhotos[location.id as keyof typeof facilityPhotos].alt} loading="lazy" /><figcaption>{facilityPhotos[location.id as keyof typeof facilityPhotos].caption}</figcaption></figure>}<dl><div><dt>Address</dt><dd>{location.address ?? 'Contact the main hospital for the exact address and directions.'}</dd></div><div><dt>Contact through main hospital</dt><dd><a href="tel:+911892222053">+91 1892 222053</a></dd></div></dl>{location.services.length>0&&<ul class="service-tags" aria-label="Services">{location.services.map(service=><li>{service}</li>)}</ul>}<div class="actions">{location.directions&&<a class="button" href={location.directions}>Get directions ↗</a>}{location.schedule&&<a class="text-link" href="/find-care/schedules">Clinic hours →</a>}{!location.directions&&<a class="text-link" href="/contact">Ask about this facility →</a>}</div>
 {location.map?<div class="location-map" data-map-src={location.map}><div class="map-overlay"><button type="button" data-load-map>Show interactive map</button><span>Loads Google Maps when selected</span></div></div>:<p class="location-note">Please confirm directions and services with the hospital before travelling.</p>}
 </section>)}</div>
</div></div></BaseLayout>
<style>
.facility-photo{margin-top:28px}.facility-photo img{width:100%;height:auto;max-height:480px;object-fit:contain;object-position:left center}.facility-photo figcaption{font-size:12px;color:var(--color-text-muted);margin-top:10px}.location-explorer{display:grid;grid-template-columns:280px 1fr;gap:64px;padding-bottom:80px;align-items:start}.location-picker{position:sticky;top:112px}.location-picker[hidden]{display:none}.location-explorer:not(:has(.location-picker:not([hidden]))){grid-template-columns:1fr}.location-picker button{position:relative;display:block;width:100%;text-align:left;padding:24px 36px 24px 20px;border-bottom:1px solid #d8ddd3;border-left:3px solid transparent;cursor:pointer}.location-picker button[aria-pressed=true]{background:#edf1e9;border-left-color:var(--color-accent)}.place-name{display:block;font-size:20px;font-weight:500}.place-type{display:block;margin-top:6px;font-size:12px;color:var(--color-text-muted)}.place-arrow{position:absolute;right:16px;top:26px;color:var(--color-accent)}.location-panel[hidden]{display:none}.location-panel{padding-bottom:32px}.location-panel h2{font-size:clamp(28px,3vw,38px);font-weight:500;line-height:1.2;margin-bottom:20px}.location-panel>p{font-size:17px;line-height:1.8;color:var(--color-text-muted);max-width:60ch}.location-panel dl{display:grid;grid-template-columns:1.4fr 1fr;gap:32px;padding-block:28px;margin-top:24px;border-block:1px solid #d8ddd3}.location-panel dt{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:var(--color-text-muted);margin-bottom:10px}.location-panel dd{font-size:15px;line-height:1.8}.location-panel dd a{text-decoration:underline;text-underline-offset:4px}.service-tags{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin-top:24px;padding:0}.service-tags li{font-size:12px;padding:6px 10px;border:1px solid #d8ddd3;border-radius:4px}.location-panel .actions{align-items:center}.location-map{position:relative;margin-top:32px;height:320px;background:#edf1e9;overflow:hidden}.location-map>img{width:100%;height:100%;object-fit:cover}.map-overlay{position:absolute;inset:0;display:flex;flex-direction:column;gap:10px;align-items:center;justify-content:center;background:var(--color-accent)}.map-overlay button{background:white;padding:14px 22px;border-radius:6px;font-size:14px;font-weight:600;cursor:pointer}.map-overlay span{color:white;font-size:12px}.location-map iframe{width:100%;height:100%;border:0}.location-note{font-size:14px!important;margin-top:32px}.location-picker button:focus-visible,.map-overlay button:focus-visible{outline:2px solid var(--color-accent);outline-offset:3px}
@media(max-width:767px){.location-explorer{grid-template-columns:1fr;gap:32px;padding-bottom:40px}.location-picker{position:static;display:flex;overflow-x:auto;gap:8px;padding-bottom:8px}.location-picker button{min-width:160px;padding:16px;flex:1;border-left:0;border-bottom:3px solid transparent}.location-picker button[aria-pressed=true]{border-bottom-color:var(--color-accent)}.place-name{font-size:17px}.place-arrow{display:none}.location-panel dl{grid-template-columns:1fr;gap:24px}.location-map{height:260px}}
</style>
<script>
function initLocations(){
 const explorer=document.querySelector<HTMLElement>('[data-locations]');if(!explorer)return;
 const picker=explorer.querySelector<HTMLElement>('.location-picker')!;picker.hidden=false;
 const panels=Array.from(explorer.querySelectorAll<HTMLElement>('[data-location-panel]'));
 const select=(id:string)=>{if(!panels.some(p=>p.dataset.locationPanel===id))id='main-hospital';panels.forEach(p=>p.hidden=p.dataset.locationPanel!==id);picker.querySelectorAll<HTMLButtonElement>('[data-location]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.location===id)));};
 select(location.hash.replace('#location-',''));
 picker.addEventListener('click',e=>{const b=(e.target as Element).closest<HTMLButtonElement>('[data-location]');if(!b)return;select(b.dataset.location!);history.replaceState(null,'',`#location-${b.dataset.location}`);});
 explorer.querySelectorAll<HTMLButtonElement>('[data-load-map]').forEach(button=>button.addEventListener('click',()=>{const container=button.closest<HTMLElement>('[data-map-src]')!;const frame=document.createElement('iframe');frame.title='Delek Hospital map';frame.src=container.dataset.mapSrc!;frame.referrerPolicy='no-referrer-when-downgrade';container.replaceChildren(frame);frame.focus();}));
}
document.addEventListener('astro:page-load',initLocations);
</script>
