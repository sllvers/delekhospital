---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/schedules.css';
import { schedule } from '../../data/care';
const days = ['Monday','Tuesday','Wednesday','Thursday','Friday'];
---
<BaseLayout title="Clinics & Schedules — Delek Hospital" description="Browse Delek Hospital’s weekly clinic timetable by facility and day, with specialist and Saturday hours.">
<div class="schedule-page content-wrap">
<header class="schedule-intro">
 <div><p class="eyebrow">Find care / Clinic schedules</p><h1>Plan your visit.</h1><p class="schedule-lead">Find your clinic, check the hours, and know what to expect before you arrive.</p></div>
 <aside class="visit-reminder"><span class="reminder-icon" aria-hidden="true">↗</span><div><strong>A quick call before you travel</strong><p>Confirm clinic availability and appointments with the hospital.</p><a href="tel:+911892222053">+91 1892 222053</a></div></aside>
</header>
<div class="clinic-planner" data-schedule>
 <div class="planner-tools" hidden><div class="filter-step"><p class="filter-label"><span>1</span> Choose your facility</p><div class="facility-switch" role="group" aria-label="Choose a facility"><button type="button" data-facility="main" aria-pressed="true">Main Hospital</button><button type="button" data-facility="branch" aria-pressed="false">McLeod Ganj</button></div></div><div class="filter-step day-step"><p class="filter-label"><span>2</span> Choose a weekday</p><div class="day-switch" role="group" aria-label="Filter by day"><button type="button" data-day="all" aria-pressed="true">Full week</button>{days.map(day => <button type="button" data-day={day} aria-pressed="false" aria-label={day}><span class="day-long">{day}</span><span class="day-short" aria-hidden="true">{day.slice(0,3)}</span></button>)}</div></div></div>
 <div class="service-filter" hidden><span></span><button type="button">Show all clinics</button></div>
 <p class="planner-status" role="status" aria-live="polite">Weekly clinic information · Monday–Friday</p>
 <div class="timetable"><table><caption class="sr-only">Clinic hours and appointment information</caption><thead><tr><th scope="col">Clinic / service</th><th scope="col">Days</th><th scope="col">Hours</th><th scope="col">Before you visit</th></tr></thead><tbody>{schedule.clinics.map(clinic => <tr data-clinic={clinic.id} data-site={clinic.facility} data-days={clinic.weekdays.join(',')}><th scope="row">{clinic.name}<span class="clinic-frequency">{clinic.days === 'Monday–Friday' ? 'Weekday service' : clinic.id === 'immunization' ? 'Monthly clinic' : !clinic.days ? 'By appointment' : 'Scheduled clinic'}</span></th><td data-label="Days">{clinic.days ?? 'By arrangement'}</td><td data-label="Hours"><span class:list={['hours',{'needs-confirmation':!clinic.hours}]}>{clinic.hours ?? 'Call to confirm'}</span></td><td data-label="Visit information">{clinic.note}</td></tr>)}</tbody></table></div>
 <p class="empty-schedule" hidden>No regular clinics are listed for this selection. Please call the hospital for availability.</p>
 <p class="note planner-footnote">Monthly clinics appear under their weekday; check the listed week of the month. By-arrangement clinics are shown for every weekday; this does not confirm an appointment. {schedule.reviewedOn && `Schedule confirmed: ${schedule.reviewedOn}.`}</p>
</div>
<section class="saturday-section"><div><span class="eyebrow">Main hospital / Saturdays</span><h2>Visiting on Saturday?</h2><p class="note">For General OPD, Dentistry, Laboratory and Pharmacy at the main hospital.</p></div><ol class="saturday-strip">{schedule.saturdays.map((day,index) => <li class:list={{closed:day.hours==='Closed',unconfirmed:!day.hours}}><span class="saturday-number">{index+1}<small>{['st','nd','rd','th','th'][index]}</small></span><span class="saturday-label">Saturday</span><strong>{day.hours ?? 'Call to confirm'}</strong></li>)}</ol></section>
<div class="schedule-contact"><p><strong>Ready to find your way?</strong><span>Get directions, or call us for help planning your visit.</span></p><a class="text-link" href="tel:+911892222053">Call +91 1892 222053 →</a><a class="text-link" href="/find-care/locations">Find your clinic →</a></div>
</div></BaseLayout>

<script>
function initSchedule(){
 const planner=document.querySelector<HTMLElement>('[data-schedule]');if(!planner)return;
 const tools=planner.querySelector<HTMLElement>('.planner-tools')!;tools.hidden=false;
 let site='main',day='all';
 const requested=new URLSearchParams(location.search).get('clinic');
 const selected=Array.from(planner.querySelectorAll<HTMLElement>('[data-clinic]')).find(row=>row.dataset.clinic===requested);
 let clinic=selected?.dataset.clinic ?? '';
 if(selected)site=selected.dataset.site!;
 const filter=planner.querySelector<HTMLElement>('.service-filter')!;
 filter.hidden=!clinic;
 filter.querySelector('span')!.textContent=selected?.querySelector('th')?.textContent ?? '';
 const render=()=>{
  let count=0;planner.querySelectorAll<HTMLElement>('[data-clinic]').forEach(row=>{row.hidden=(!!clinic&&row.dataset.clinic!==clinic)||row.dataset.site!==site||(day!=='all'&&!!row.dataset.days&&!row.dataset.days.split(',').includes(day));if(!row.hidden)count++;});
  planner.querySelectorAll<HTMLButtonElement>('[data-facility]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.facility===site)));
  planner.querySelectorAll<HTMLButtonElement>('[data-day]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.day===day)));
  planner.querySelector<HTMLElement>('.planner-status')!.textContent=`${site==='main'?'Main Hospital':'McLeod Ganj'} · ${day==='all'?'Monday–Friday':day} · ${count} listed ${count===1?'service':'services'}`;
  planner.querySelector<HTMLElement>('.empty-schedule')!.hidden=count>0;
 };
 filter.querySelector('button')!.addEventListener('click',()=>{clinic='';filter.hidden=true;const url=new URL(location.href);url.searchParams.delete('clinic');history.replaceState(null,'',url);render();});
 tools.addEventListener('click',e=>{const b=(e.target as Element).closest<HTMLButtonElement>('button');if(!b)return;if(b.dataset.facility){site=b.dataset.facility;clinic='';filter.hidden=true;const url=new URL(location.href);url.searchParams.delete('clinic');history.replaceState(null,'',url);}if(b.dataset.day)day=b.dataset.day;render();});render();
}
document.addEventListener('astro:page-load',initSchedule);
</script>
