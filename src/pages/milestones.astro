---
import BaseLayout from '../layouts/BaseLayout.astro';

const milestones = [
  {
    year: '2024',
    title: 'Advanced Robotic Surgery Suite',
    description: 'Launched our state-of-the-art robotic surgical center, enabling ultra-precise minimally invasive procedures across oncology and cardiology.',
    tag: 'Technology'
  },
  {
    year: '2021',
    title: 'Regional Trauma Center Designation',
    description: 'Officially designated as a Level-1 Trauma Center, providing round-the-clock critical emergency care for the entire metropolitan region.',
    tag: 'Emergency'
  },
  {
    year: '2016',
    title: 'Institute for Clinical Research',
    description: 'Established our dedicated clinical trials wing, bringing breakthrough therapeutic protocols directly to our patients.',
    tag: 'Research'
  },
  {
    year: '2010',
    title: 'Pediatric Care Expansion',
    description: 'Opened the comprehensive Children’s Health Pavilion, featuring specialized neonatal intensive care and family support facilities.',
    tag: 'Pediatrics'
  },
  {
    year: '2002',
    title: 'Community Outreach Initiative',
    description: 'Launched mobile wellness clinics providing preventative screenings and health education to underserved neighborhoods.',
    tag: 'Community'
  },
  {
    year: '1995',
    title: 'Hospital Name Foundation',
    description: 'Founded as an independent, non-profit healthcare institution committed to uncompromised medical excellence and patient-first values.',
    tag: 'Heritage'
  }
];
---

<BaseLayout title="Milestones & History — Hospital Name">
  <div class="max-w-[1400px] mx-auto px-[var(--space-6)] py-[var(--space-16)]">
    <!-- Header -->
    <div class="max-w-2xl mb-[var(--space-16)]">
      <span class="text-[var(--font-size-xs)] uppercase tracking-[0.2em] text-[var(--color-text-muted)] mb-[var(--space-2)] block">
        Our History
      </span>
      <h1 class="text-[var(--font-size-4xl)] md:text-[var(--font-size-5xl)] font-[var(--font-weight-semibold)] tracking-tight text-[var(--color-primary)] mb-[var(--space-4)]">
        Decades of breakthroughs, built on trust.
      </h1>
      <p class="text-[var(--font-size-base)] text-[var(--color-text-muted)] leading-[var(--leading-relaxed)]">
        Trace the key milestones that shaped Hospital Name into a leading non-profit medical institution dedicated to lifelong community wellness.
      </p>
    </div>

    <!-- Timeline Container -->
    <div class="relative">
      <!-- Center Line (Desktop) / Left Line (Mobile) -->
      <div class="absolute left-[20px] md:left-1/2 top-0 bottom-0 w-[1px] bg-[var(--color-surface-alt)] -translate-x-1/2"></div>

      <div class="space-y-[var(--space-12)]">
        {milestones.map((item, index) => {
          const isEven = index % 2 === 0;
          return (
            <div class={`relative flex flex-col md:flex-row items-start ${isEven ? 'md:flex-row-reverse' : ''}`}>
              <!-- Content Box -->
              <div class="w-full md:w-[calc(50%-40px)] pl-[50px] md:pl-0">
                <div class="p-[var(--space-6)] rounded-[var(--radius-lg)] bg-[var(--color-surface-alt)] border border-[var(--color-surface-alt)] hover:border-[var(--color-primary-muted)] transition-colors duration-[var(--duration-base)]">
                  <div class="flex items-center justify-between mb-[var(--space-2)]">
                    <span class="text-[var(--font-size-xs)] uppercase tracking-[0.15em] text-[var(--color-text-muted)]">
                      {item.tag}
                    </span>
                    <span class="text-[var(--font-size-sm)] font-[var(--font-weight-semibold)] text-[var(--color-primary)] px-[var(--space-2)].5 py-[var(--space-1)] rounded-[var(--radius-sm)] bg-[var(--color-surface)]">
                      {item.year}
                    </span>
                  </div>
                  <h3 class="text-[var(--font-size-xl)] font-[var(--font-weight-semibold)] text-[var(--color-primary)] mb-[var(--space-2)]">
                    {item.title}
                  </h3>
                  <p class="text-[var(--font-size-sm)] text-[var(--color-text-muted)] leading-[var(--leading-relaxed)]">
                    {item.description}
                  </p>
                </div>
              </div>

              <!-- Timeline Dot -->
              <div class="absolute left-[20px] md:left-1/2 top-[var(--space-6)] w-[12px] h-[12px] rounded-full bg-[var(--color-primary)] border-4 border-[var(--color-surface)] -translate-x-1/2 z-10"></div>

              <!-- Spacer for alternating side on desktop -->
              <div class="hidden md:block md:w-[calc(50%-40px)]"></div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>
